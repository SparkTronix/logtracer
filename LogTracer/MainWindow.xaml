<Window x:Class="LogTracer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LogTracer — системные журналы Windows"
        MinHeight="680"
        MinWidth="1000"
        Height="860"
        Width="1280">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock FontSize="22" FontWeight="SemiBold" Text="Системные события Windows" />

        <Grid Grid.Row="1" Margin="0,16,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel>
                <TextBlock Margin="0,0,0,4" Text="Поиск по источнику, сообщению и журналу" />
                <TextBox x:Name="SearchTextBox" TextChanged="FilterChanged" />
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Margin="0,0,0,4" Text="ID события" />
                <TextBox x:Name="EventIdTextBox" TextChanged="FilterChanged" />
            </StackPanel>
            <StackPanel Grid.Column="4">
                <TextBlock Margin="0,0,0,4" Text="Журнал" />
                <ComboBox x:Name="LogComboBox" SelectionChanged="FilterChanged" />
            </StackPanel>
            <StackPanel Grid.Column="6">
                <TextBlock Margin="0,0,0,4" Text="Уровень" />
                <ComboBox x:Name="LevelComboBox" SelectionChanged="FilterChanged" />
            </StackPanel>
            <Button x:Name="ReloadButton" Grid.Column="8" Padding="18,7" VerticalAlignment="Bottom" Click="ReloadButton_Click" Content="Обновить" />
        </Grid>

        <StackPanel Grid.Row="2" Margin="0,0,0,12" Orientation="Horizontal" VerticalAlignment="Center">
            <TextBlock Margin="0,0,12,0" FontWeight="SemiBold" VerticalAlignment="Center" Text="Автообновление:" />
            <RadioButton x:Name="AutoRefreshOffButton" Margin="0,0,12,0" GroupName="AutoRefresh" IsChecked="True" Tag="Off" Checked="AutoRefreshModeChanged">Выключено</RadioButton>
            <RadioButton Margin="0,0,12,0" GroupName="AutoRefresh" Tag="RealTime" Checked="AutoRefreshModeChanged">В реальном времени</RadioButton>
            <RadioButton Margin="0,0,12,0" GroupName="AutoRefresh" Tag="5" Checked="AutoRefreshModeChanged">5 секунд</RadioButton>
            <RadioButton Margin="0,0,12,0" GroupName="AutoRefresh" Tag="10" Checked="AutoRefreshModeChanged">10 секунд</RadioButton>
            <RadioButton Margin="0,0,12,0" GroupName="AutoRefresh" Tag="15" Checked="AutoRefreshModeChanged">15 секунд</RadioButton>
            <RadioButton GroupName="AutoRefresh" Tag="30" Checked="AutoRefreshModeChanged">30 секунд</RadioButton>
        </StackPanel>

        <Grid Grid.Row="3">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" MinHeight="180" />
                <RowDefinition Height="8" />
                <RowDefinition Height="220" MinHeight="120" />
            </Grid.RowDefinitions>

            <DataGrid x:Name="EventsDataGrid"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      IsReadOnly="True"
                      SelectionMode="Single"
                      HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal"
                      AlternatingRowBackground="#F5F5F5">
                <DataGrid.Columns>
                    <DataGridTextColumn Width="160" Binding="{Binding Timestamp, StringFormat={}{0:yyyy-MM-dd HH:mm:ss}}" Header="Время" />
                    <DataGridTextColumn Width="110" Binding="{Binding LogName}" Header="Журнал" />
                    <DataGridTextColumn Width="105" Binding="{Binding Level}" Header="Уровень" />
                    <DataGridTextColumn Width="90" Binding="{Binding EventId}" Header="ID" />
                    <DataGridTextColumn Width="180" Binding="{Binding Source}" Header="Источник" />
                    <DataGridTextColumn Width="*" Binding="{Binding Summary}" Header="Сообщение" />
                </DataGrid.Columns>
            </DataGrid>

            <GridSplitter Grid.Row="1" Height="8" HorizontalAlignment="Stretch" ResizeDirection="Rows" ResizeBehavior="PreviousAndNext" />

            <Border Grid.Row="2" BorderBrush="#D0D0D0" BorderThickness="1" Padding="12" DataContext="{Binding SelectedItem, ElementName=EventsDataGrid}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Margin="0,0,16,0" FontSize="16" FontWeight="SemiBold" Text="Выбранное событие" />
                        <TextBlock Margin="0,0,12,0" Text="{Binding Timestamp, StringFormat={}{0:yyyy-MM-dd HH:mm:ss}}" />
                        <TextBlock Margin="0,0,12,0" Text="{Binding LogName}" />
                        <TextBlock Margin="0,0,12,0" Text="{Binding Level}" />
                        <TextBlock Margin="0,0,12,0" Text="{Binding EventId, StringFormat=ID: {0}}" />
                        <TextBlock Text="{Binding Source}" />
                    </StackPanel>
                    <TextBox Grid.Row="1" Margin="0,10,0,0" BorderThickness="0" Background="Transparent" IsReadOnly="True" Text="{Binding Message}" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" />
                </Grid>
            </Border>
        </Grid>

        <TextBlock x:Name="StatusTextBlock" Grid.Row="4" Margin="0,10,0,0" Foreground="DimGray" />
    </Grid>
</Window>
