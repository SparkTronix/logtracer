<Window x:Class="LogTracer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LogTracer — системные журналы Windows"
        MinHeight="760"
        MinWidth="1000"
        Height="920"
        Width="1280">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock FontSize="22" FontWeight="SemiBold" Text="Системные события Windows" />

        <Border Grid.Row="1" Margin="0,12,0,16" BorderBrush="#D0D0D0" BorderThickness="1" CornerRadius="3" Padding="0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Margin="12,7">
                    <TextBlock Foreground="DimGray" Text="Всего" />
                    <TextBlock x:Name="TotalEventsCountTextBlock" FontSize="18" FontWeight="SemiBold" Text="0" />
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="12,7">
                    <TextBlock Foreground="#D03B3B" Text="Ошибки" />
                    <TextBlock x:Name="ErrorEventsCountTextBlock" FontSize="18" FontWeight="SemiBold" Text="0" />
                </StackPanel>
                <StackPanel Grid.Column="2" Margin="12,7">
                    <TextBlock Foreground="#8A5A00" Text="Предупреждения" />
                    <TextBlock x:Name="WarningEventsCountTextBlock" FontSize="18" FontWeight="SemiBold" Text="0" />
                </StackPanel>
                <StackPanel Grid.Column="3" Margin="12,7">
                    <TextBlock Foreground="#256ABF" Text="Сведения" />
                    <TextBlock x:Name="InformationEventsCountTextBlock" FontSize="18" FontWeight="SemiBold" Text="0" />
                </StackPanel>
                <StackPanel Grid.Column="4" Margin="12,7">
                    <TextBlock Foreground="#006300" Text="Аудит успеха" />
                    <TextBlock x:Name="SuccessAuditEventsCountTextBlock" FontSize="18" FontWeight="SemiBold" Text="0" />
                </StackPanel>
                <StackPanel Grid.Column="5" Margin="12,7">
                    <TextBlock Foreground="#EC835A" Text="Аудит отказа" />
                    <TextBlock x:Name="FailureAuditEventsCountTextBlock" FontSize="18" FontWeight="SemiBold" Text="0" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="2" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel>
                <TextBlock Margin="0,0,0,4" Text="Поиск по источнику, сообщению и журналу" />
                <TextBox x:Name="SearchTextBox" TextChanged="FilterChanged" />
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Margin="0,0,0,4" Text="ID события" />
                <TextBox x:Name="EventIdTextBox" TextChanged="FilterChanged" />
            </StackPanel>
            <StackPanel Grid.Column="4">
                <TextBlock Margin="0,0,0,4" Text="Журнал" />
                <ComboBox x:Name="LogComboBox" SelectionChanged="FilterChanged" />
            </StackPanel>
            <StackPanel Grid.Column="6">
                <TextBlock Margin="0,0,0,4" Text="Уровень" />
                <ComboBox x:Name="LevelComboBox" SelectionChanged="FilterChanged" />
            </StackPanel>
            <Button x:Name="ReloadButton" Grid.Column="8" Padding="18,7" VerticalAlignment="Bottom" Click="ReloadButton_Click" Content="Обновить" />
        </Grid>

        <Grid Grid.Row="3" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="360" />
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Margin="0,0,12,0" FontWeight="SemiBold" VerticalAlignment="Center" Text="Период:" />
                <TextBlock Margin="0,0,6,0" VerticalAlignment="Center" Text="С" />
                <DatePicker x:Name="StartDatePicker" Width="130" SelectedDateChanged="FilterChanged" />
                <ComboBox x:Name="StartHourComboBox" Width="44" Margin="6,0,0,0" ToolTip="Часы" SelectionChanged="FilterChanged" />
                <TextBlock Margin="3,0" VerticalAlignment="Center" Text=":" />
                <ComboBox x:Name="StartMinuteComboBox" Width="44" Margin="0,0,16,0" ToolTip="Минуты" SelectionChanged="FilterChanged" />
                <TextBlock Margin="0,0,6,0" VerticalAlignment="Center" Text="По" />
                <DatePicker x:Name="EndDatePicker" Width="130" SelectedDateChanged="FilterChanged" />
                <ComboBox x:Name="EndHourComboBox" Width="44" Margin="6,0,0,0" ToolTip="Часы" SelectionChanged="FilterChanged" />
                <TextBlock Margin="3,0" VerticalAlignment="Center" Text=":" />
                <ComboBox x:Name="EndMinuteComboBox" Width="44" Margin="0,0,16,0" ToolTip="Минуты" SelectionChanged="FilterChanged" />
                <Button Padding="12,5" Click="ClearDateFilterButton_Click" Content="Сбросить период" />
            </StackPanel>

            <Expander Grid.Column="2" Header="Журналы для загрузки">
                <Border Margin="0,6,0,0" BorderBrush="#D0D0D0" BorderThickness="1" Padding="6">
                    <ScrollViewer Height="150" VerticalScrollBarVisibility="Auto">
                        <ListBox x:Name="JournalOptionsListBox" BorderThickness="0">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <CheckBox Content="{Binding Name}" IsChecked="{Binding IsSelected, Mode=TwoWay}" Checked="JournalSelectionChanged" Unchecked="JournalSelectionChanged" />
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </ScrollViewer>
                </Border>
            </Expander>
        </Grid>

        <DockPanel Grid.Row="4" Margin="0,0,0,12">
            <Button x:Name="ExportButton" DockPanel.Dock="Right" Padding="18,7" Click="ExportButton_Click" Content="Сохранить в CSV" />
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Margin="0,0,12,0" FontWeight="SemiBold" VerticalAlignment="Center" Text="Автообновление:" />
                <RadioButton x:Name="AutoRefreshOffButton" Margin="0,0,12,0" GroupName="AutoRefresh" IsChecked="True" Tag="Off" Checked="AutoRefreshModeChanged">Выключено</RadioButton>
                <RadioButton Margin="0,0,12,0" GroupName="AutoRefresh" Tag="RealTime" Checked="AutoRefreshModeChanged">В реальном времени</RadioButton>
                <RadioButton Margin="0,0,12,0" GroupName="AutoRefresh" Tag="5" Checked="AutoRefreshModeChanged">5 секунд</RadioButton>
                <RadioButton Margin="0,0,12,0" GroupName="AutoRefresh" Tag="10" Checked="AutoRefreshModeChanged">10 секунд</RadioButton>
                <RadioButton Margin="0,0,12,0" GroupName="AutoRefresh" Tag="15" Checked="AutoRefreshModeChanged">15 секунд</RadioButton>
                <RadioButton GroupName="AutoRefresh" Tag="30" Checked="AutoRefreshModeChanged">30 секунд</RadioButton>
            </StackPanel>
        </DockPanel>

        <Grid Grid.Row="5">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" MinHeight="180" />
                <RowDefinition Height="8" />
                <RowDefinition Height="220" MinHeight="120" />
            </Grid.RowDefinitions>

            <DataGrid x:Name="EventsDataGrid"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      IsReadOnly="True"
                      SelectionMode="Single"
                      HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal"
                      AlternatingRowBackground="#F5F5F5">
                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Level}" Value="Ошибка">
                                <Setter Property="Background" Value="#FFF4CCCC" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.RowStyle>
                <DataGrid.Columns>
                    <DataGridTextColumn Width="160" Binding="{Binding Timestamp, StringFormat={}{0:yyyy-MM-dd HH:mm:ss}}" Header="Время" />
                    <DataGridTextColumn Width="110" Binding="{Binding LogName}" Header="Журнал" />
                    <DataGridTextColumn Width="105" Binding="{Binding Level}" Header="Уровень" />
                    <DataGridTextColumn Width="90" Binding="{Binding EventId}" Header="ID" />
                    <DataGridTextColumn Width="180" Binding="{Binding Source}" Header="Источник" />
                    <DataGridTextColumn Width="*" Binding="{Binding Summary}" Header="Сообщение" />
                </DataGrid.Columns>
            </DataGrid>

            <GridSplitter Grid.Row="1" Height="8" HorizontalAlignment="Stretch" ResizeDirection="Rows" ResizeBehavior="PreviousAndNext" />

            <Border Grid.Row="2" BorderBrush="#D0D0D0" BorderThickness="1" Padding="12" DataContext="{Binding SelectedItem, ElementName=EventsDataGrid}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Margin="0,0,16,0" FontSize="16" FontWeight="SemiBold" Text="Выбранное событие" />
                        <TextBlock Margin="0,0,12,0" Text="{Binding Timestamp, StringFormat={}{0:yyyy-MM-dd HH:mm:ss}}" />
                        <TextBlock Margin="0,0,12,0" Text="{Binding LogName}" />
                        <TextBlock Margin="0,0,12,0" Text="{Binding Level}" />
                        <TextBlock Margin="0,0,12,0" Text="{Binding EventId, StringFormat=ID: {0}}" />
                        <TextBlock Text="{Binding Source}" />
                    </StackPanel>
                    <TextBox Grid.Row="1" Margin="0,10,0,0" BorderThickness="0" Background="Transparent" IsReadOnly="True" Text="{Binding Message}" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" />
                </Grid>
            </Border>
        </Grid>

        <TextBlock x:Name="StatusTextBlock" Grid.Row="6" Margin="0,10,0,0" Foreground="DimGray" />
    </Grid>
</Window>
